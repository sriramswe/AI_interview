JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL is the relational database for users, interviews, and billing.
MYSQL_URL=mysql+pymysql://root@localhost:3306/ai_interview_prep?charset=utf8mb4

# Use OpenRouter's free-model router by default, or select "ollama" or "gemini".
AI_PROVIDER=openrouter
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_OLLAMA_FALLBACK=true
# Optional attribution headers:
# OPENROUTER_SITE_URL=http://localhost:5173
# OPENROUTER_SITE_NAME=InterviewAI
# Optional local Ollama settings:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Optional LoRA adapter already available to the Ollama service:
# OLLAMA_ADAPTER_PATH=/models/interviewai-lora
# OLLAMA_ADAPTER_BASE_MODEL=llama3.2
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GOOGLE_CLIENT_ID=

# Manual UPI subscription payments
# Set the real receiving UPI ID in the backend environment; do not commit it.
# UPI_ID=your-business@bank
UPI_PAYEE_NAME=InterviewAI
# SUPER_ADMIN_EMAILS=admin@example.com
# PAYMENT_REVIEWER_EMAILS=admin@example.com
SUBSCRIPTION_DURATION_DAYS=30
